import random
import string

def generate_password():
    print("--- Strong Password Generator ---")
    print("Let's make a random password!")
    length = int(input("Enter your password length (Must be greater than 5 characters): "))

    include_uppercase = input("Include uppercase letters? (y/n): ").lower() == 'y'
    include_numbers = input("Include numbers? (y/n): ").lower() == 'y'
    include_special = input("Include special characters? (y/n): ").lower() == 'y'

    # Base character pool (always includes lowercase)
    char_pool = string.ascii_lowercase

    if include_uppercase:
        char_pool += string.ascii_uppercase
    if include_numbers:
        char_pool += string.digits
    if include_special:
        char_pool += string.punctuation

    # Generate password by randomly picking from the pool
    password = "".join(random.choice(char_pool) for _ in range(length))

    print(f"\nGenerated Password: {password}\n")

if __name__ == "__main__":
  generate_password()
